LLM_PROVIDER=gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_OR_OAUTH_TOKEN
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: restrict CORS origins in production (comma-separated)
# ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Reminder: on cloud free tiers the service may sleep/wake. The first
# request after a cold start can be slow due to model loading. Consider
# preloading models during build time (see README deployment notes).